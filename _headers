# Cloudflare Workers static-assets header rules.
# Link response headers advertise machine-readable entry points to agents
# and crawlers (RFC 8288). Applied to every page so any entry URL is discoverable.
/*
  Link: </agents/>; rel="service-doc"
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </sitemap.xml>; rel="sitemap"
  Link: </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
  # Security response headers. These are the protections a per-page
  # <meta http-equiv> cannot set: clickjacking (frame-ancestors is ignored in
  # meta), MIME sniffing, referrer leakage, feature access, and HSTS. The
  # per-page Content-Security-Policy stays in each page's <head>, because its
  # connect-src differs per tool (reference-check reaches four registries;
  # pattern-mirror reaches nothing).
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# /waves/live listens to the room by design (mic permission requested on
# click, audio stays in the analyser node — nothing recorded or sent).
# The site-wide policy above locks microphone=() everywhere, which makes the
# browser refuse getUserMedia without even prompting. Re-allow same-origin
# mic on the live piece only; every other lock stays inherited.
# Both URL forms: Cloudflare serves the extensionless path (auto-trailing-slash).
/waves/live
  ! Permissions-Policy
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
/waves/live.html
  ! Permissions-Policy
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
