{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vahtian",
  "compatibility_date": "2026-06-12",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
